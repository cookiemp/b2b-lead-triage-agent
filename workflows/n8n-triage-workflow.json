{
  "name": "Triage inbound B2B leads and send email alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "b2b-lead-triage",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2b-webhook-trigger",
      "name": "Inbound Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [240, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://b2b-lead-triage-agent.vercel.app/api/triage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $(\"Inbound Lead Webhook\").item.json.body?.name ?? $(\"Inbound Lead Webhook\").item.json.name ?? \"\", email: $(\"Inbound Lead Webhook\").item.json.body?.email ?? $(\"Inbound Lead Webhook\").item.json.email ?? \"\", company_url: $(\"Inbound Lead Webhook\").item.json.body?.company_url ?? $(\"Inbound Lead Webhook\").item.json.company_url ?? \"\", message: $(\"Inbound Lead Webhook\").item.json.body?.message ?? $(\"Inbound Lead Webhook\").item.json.message ?? \"\", source: \"n8n\" }) }}",
        "options": {
          "timeout": 28000
        }
      },
      "id": "b2b-call-triage-api",
      "name": "Call Triage API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [528, 320],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpCustomAuth": {
          "name": "Triage API Webhook Secret"
        }
      }
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "renameOutput": true,
              "outputKey": "auto_routed",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $(\"Call Triage API\").item.json.lead?.status ?? \"\" }}",
                    "rightValue": "auto_routed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "needs_human_review",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $(\"Call Triage API\").item.json.lead?.status ?? \"\" }}",
                    "rightValue": "needs_human_review",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "auto_rejected",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $(\"Call Triage API\").item.json.lead?.status ?? \"\" }}",
                    "rightValue": "auto_rejected",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Other"
        }
      },
      "id": "b2b-status-switch",
      "name": "Route by Triage Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.5,
      "position": [800, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: \"Lead Triage <onboarding@resend.dev>\", to: [\"ops@yourcompany.com\"], subject: \"[Auto-Routed] \" + ($(\"Call Triage API\").item.json.lead?.name ?? \"Lead\") + \" (\" + ($(\"Call Triage API\").item.json.lead?.email ?? \"\") + \")\", text: \"Qualified lead auto-routed via n8n.\\n\\nCompany: \" + ($(\"Call Triage API\").item.json.lead?.company_url ?? \"n/a\") + \"\\nRoute: \" + ($(\"Call Triage API\").item.json.lead?.triage_json?.suggested_route ?? \"sales\") + \"\\nICP: \" + ($(\"Call Triage API\").item.json.lead?.icp_score ?? \"n/a\") + \"/100 | Confidence: \" + ($(\"Call Triage API\").item.json.lead?.confidence_score ?? \"n/a\") + \"\\n\\nDraft reply:\\n\" + ($(\"Call Triage API\").item.json.lead?.draft_reply ?? \"\") + \"\\n\\nInbox: https://b2b-lead-triage-agent.vercel.app\" }) }}",
        "options": {
          "timeout": 8000
        }
      },
      "id": "b2b-email-sales",
      "name": "Email Sales Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1104, 128],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpCustomAuth": {
          "name": "Resend API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: \"Lead Triage <onboarding@resend.dev>\", to: [\"ops@yourcompany.com\"], subject: \"[Needs Review] \" + ($(\"Call Triage API\").item.json.lead?.name ?? \"Lead\") + \" (\" + ($(\"Call Triage API\").item.json.lead?.email ?? \"\") + \")\", text: \"Inbound lead held for human approval.\\n\\nCompany: \" + ($(\"Call Triage API\").item.json.lead?.company_url ?? \"n/a\") + \"\\nReason: \" + ($(\"Call Triage API\").item.json.routing_reason ?? \"review required\") + \"\\nConfidence: \" + ($(\"Call Triage API\").item.json.lead?.confidence_score ?? \"n/a\") + \"\\n\\nReview queue: https://b2b-lead-triage-agent.vercel.app\" }) }}",
        "options": {
          "timeout": 8000
        }
      },
      "id": "b2b-email-review",
      "name": "Email Review Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1104, 320],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpCustomAuth": {
          "name": "Resend API Key"
        }
      }
    },
    {
      "parameters": {},
      "id": "b2b-silent-spam-archive",
      "name": "Silent Spam Archive",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1104, 528]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, lead_id: $(\"Call Triage API\").item.json.lead?.id ?? null, status: $(\"Call Triage API\").item.json.lead?.status ?? \"unknown\", routing_reason: $(\"Call Triage API\").item.json.routing_reason ?? \"\" }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b2b-respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1424, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: \"upstream_error\", message: $json.error?.message ?? $json.message ?? \"Upstream request failed\" }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "b2b-respond-error",
      "name": "Respond Upstream Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1424, 624]
    },
    {
      "parameters": {
        "content": "## B2B Inbound Lead Triage Orchestrator\n\nReceives inbound lead webhooks at `POST /webhook/b2b-lead-triage`, calls the Vercel `/api/triage` endpoint, routes by triage status, and dispatches Resend email alerts.\n\n**Credentials required (HTTP Custom Auth):**\n1. `Triage API Webhook Secret` (`{\"headers\":{\"X-Webhook-Secret\":\"<WEBHOOK_SECRET>\"}}`)\n2. `Resend API Key` (`{\"headers\":{\"Authorization\":\"Bearer <RESEND_API_KEY>\"}}`)",
        "height": 272,
        "width": 448,
        "color": 4
      },
      "id": "b2b-overview-note",
      "name": "Overview Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [160, 512]
    }
  ],
