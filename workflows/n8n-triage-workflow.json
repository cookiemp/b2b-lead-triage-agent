{
  "name": "B2B Inbound Lead Triage & Alert Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "b2b-lead-triage",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2b-webhook-trigger",
      "name": "Inbound Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://b2b-lead-triage-agent.vercel.app/api/triage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.TRIAGE_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.body.name, email: $json.body.email, company_url: $json.body.company_url, message: $json.body.message, source: 'n8n' }) }}",
        "options": {
          "timeout": 28000
        }
      },
      "id": "b2b-call-triage-api",
      "name": "Call Triage API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.lead.status }}",
                    "rightValue": "auto_routed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "auto_routed"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.lead.status }}",
                    "rightValue": "needs_human_review",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "needs_human_review"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.lead.status }}",
                    "rightValue": "auto_rejected",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "auto_rejected"
            }
          ]
        },
        "options": {}
      },
      "id": "b2b-status-switch",
      "name": "Route by Triage Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: `[Auto-Routed] ${$json.lead.name} (${$json.lead.email}) -> ${$json.lead.triage_json?.suggested_route ?? 'sales'} | ICP ${$json.lead.icp_score}/100 | Conf ${$json.lead.confidence_score}\\nDraft: ${$json.lead.draft_reply ?? ''}` }) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "b2b-alert-sales",
      "name": "Notify Sales Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: `[Needs Human Review] ${$json.lead.name} (${$json.lead.email}) | Reason: ${$json.routing_reason} | Conf ${$json.lead.confidence_score ?? 'n/a'}\\nReview queue: https://b2b-lead-triage-agent.vercel.app` }) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "b2b-alert-review",
      "name": "Notify Human Review Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300]
    },
    {
      "parameters": {},
      "id": "b2b-silent-spam-archive",
      "name": "Silent Spam Archive",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1040, 440]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, lead_id: $('Call Triage API').item.json.lead.id, status: $('Call Triage API').item.json.lead.status, routing_reason: $('Call Triage API').item.json.routing_reason }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b2b-respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 300]
    }
  ],
  "connections": {
    "Inbound Lead Webhook": {
      "main": [
        [
          {
            "node": "Call Triage API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Triage API": {
      "main": [
        [
          {
            "node": "Route by Triage Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Triage Status": {
      "main": [
        [
          {
            "node": "Notify Sales Channel",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Human Review Queue",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Silent Spam Archive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Sales Channel": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Human Review Queue": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Silent Spam Archive": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
