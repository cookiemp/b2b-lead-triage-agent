# Copy to .env.local and fill in real values (NEVER commit .env.local)

# Google Gemini API (Google AI Studio free tier)
GEMINI_API_KEY=
# Comma-separated fallback chain tried in order on 429/5xx/404/timeout/invalid JSON
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Public demo daily quota protection (optional, defaults to 100/day)
DEMO_DAILY_CAP=100

# Supabase PostgreSQL (use service role key server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Langfuse Observability (optional in offline tests, required for live tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Programmatic Webhook Auth (required for source="webhook" and source="n8n")
WEBHOOK_SECRET=

# Optional Phase 4 Outbound Alerts: Email via Resend (recommended) or Discord/Slack webhook
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Lead Triage <onboarding@resend.dev>
ALERT_WEBHOOK_URL=
